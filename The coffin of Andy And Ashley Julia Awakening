  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const body = document.body;
      const progressBar = document.getElementById('progress-bar');
      const themeBtn = document.getElementById('theme-btn');
      const tocBtn = document.getElementById('toc-btn');
      const fontBtn = document.getElementById('font-btn');
      const tocPanel = document.querySelector('.toc-panel');

      // Temas
      const savedTheme = localStorage.getItem('theme') || 'light';
      body.setAttribute('data-theme', savedTheme);
      themeBtn.textContent = savedTheme === 'dark' ? '☀️ Claro' : '🌙 Escuro';

      themeBtn.addEventListener('click', () => {
        const current = body.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        body.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        themeBtn.textContent = next === 'dark' ? '☀️ Claro' : '🌙 Escuro';
      });

      // Índice
      tocBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        tocPanel.classList.toggle('active');
      });
      document.addEventListener('click', (e) => {
        if (!tocPanel.contains(e.target) && e.target !== tocBtn) {
          tocPanel.classList.remove('active');
        }
      });

      document.querySelectorAll('.toc-panel a').forEach(link => {
        link.addEventListener('click', e => {
          e.preventDefault();
          const target = document.querySelector(link.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
            tocPanel.classList.remove('active');
          }
        });
      });

      // Tamanho da Fonte
      const fontSizes = [16, 18, 20, 22];
      let fontIndex = fontSizes.indexOf(parseInt(localStorage.getItem('fontSize') || '18'));
      if (fontIndex === -1) fontIndex = 1;
      body.style.setProperty('--font-size', `${fontSizes[fontIndex]}px`);
      fontBtn.textContent = `🔤 ${fontSizes[fontIndex]}px`;

      fontBtn.addEventListener('click', () => {
        fontIndex = (fontIndex + 1) % fontSizes.length;
        body.style.setProperty('--font-size', `${fontSizes[fontIndex]}px`);
        localStorage.setItem('fontSize', fontSizes[fontIndex]);
        fontBtn.textContent = `🔤 ${fontSizes[fontIndex]}px`;
      });

      // Barra de Progresso
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = (scrollTop / docHeight) * 100;
        progressBar.style.width = `${progress}%`;
      });
    });
  </script>
